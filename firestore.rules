rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['id', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.id == userId
        && data.id is string
        && data.email is string
        && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function isValidStudyData(data, userId) {
      return data.keys().hasAll(['userId', 'discStateJson', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'discStateJson', 'updatedAt'])
        && data.userId == userId
        && data.userId is string
        && data.discStateJson is string
        && data.discStateJson.size() <= 1000000
        && data.updatedAt is string;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming(), userId);
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().createdAt == existing().createdAt
        && incoming().id == existing().id;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection for user study state & logs
      match /data/{dataId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(dataId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(dataId)
          && isValidStudyData(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(dataId)
          && isValidStudyData(incoming(), userId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(dataId);
      }
    }
  }
}
